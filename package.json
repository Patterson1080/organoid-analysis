{
  "name": "organoid-analysis",
  "private": true,
  "version": "0.0.0",
  "description": "Organoid Analysis Application",
  "author": "User",
  "main": "electron/main.cjs",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/osc-bridge.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.organoid.analysis",
    "productName": "Organoid Analysis",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.108.0",
    "@react-three/fiber": "^8.16.8",
    "@types/d3-polygon": "^3.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/three": "^0.165.0",
    "d3": "^7.8.5",
    "d3-polygon": "^3.0.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "ml-pca": "^4.1.1",
    "node-osc": "^11.0.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "three": "^0.165.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wait-on": "^9.0.3"
  }
}
